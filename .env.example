# 이 파일을 복사해서 ".env" 라는 이름으로 저장한 뒤, 실제 값으로 채워 넣으세요.
# .env 파일은 절대 GitHub 에 올리지 마세요! (.gitignore 에 이미 등록되어 있습니다)

# 1) DART(전자공시) OpenAPI 인증키
#    발급: https://opendart.fss.or.kr -> 회원가입 -> 인증키 신청/관리
DART_API_KEY=여기에_DART_인증키_40자리

# 2) Anthropic Claude API 키
#    발급: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=여기에_sk-ant로_시작하는_키

# 3) 텔레그램 봇 토큰과 내 chat_id
#    발급: 텔레그램에서 @BotFather 로 봇 생성 후 토큰 발급
#    chat_id 확인법은 README.md 참고
TELEGRAM_BOT_TOKEN=여기에_숫자:영숫자_형태의_봇토큰
TELEGRAM_CHAT_ID=여기에_내_chat_id

# 4) 감시할 관심 기업 목록 (JSON 배열, 한 줄로 작성)
#    corp_code 는 find_corp_code.py 로 찾을 수 있습니다.
WATCH_LIST=[{"name": "삼성전자", "corp_code": "00126380"}, {"name": "카카오", "corp_code": "00918444"}]

# --- 아래는 선택 사항 (기본값 사용해도 무방) ---

# 사용할 Claude 모델. 비용을 아끼려면 claude-haiku-4-5 로 변경 가능.
CLAUDE_MODEL=claude-sonnet-5

# 오늘 기준 며칠 전 공시까지 조회할지 (기본 2일)
LOOKBACK_DAYS=2

# Claude 에게 보낼 공시 원문 최대 글자 수 (기본 8000자)
MAX_DOC_CHARS=8000

# 공시 "제목"에 아래 키워드 중 하나라도 포함되면 알림을 보내지 않고 건너뜁니다.
# 증권사가 거의 매일 형식적으로 내는 ELB/ELS 등 파생결합증권 발행 관련 공시처럼
# 투자 판단에 의미 없는 반복성 공시를 걸러내기 위한 용도입니다.
# 이 값을 지정하지 않으면 아래 기본값이 사용됩니다. 쉼표(,)로 구분해서 자유롭게 수정하세요.
# EXCLUDE_KEYWORDS=증권발행실적보고서,일괄신고추가서류,일괄신고서,효력발생안내,파생결합증권,파생결합사채,ELB,ELS,DLS,DLB,IR개최,IR설명회,기업설명회

# --- 아래는 news_telegram_bot.py (뉴스 알림 봇, 선택사항) 전용 설정 ---
# DART_API_KEY 는 필요 없고, 위의 ANTHROPIC_API_KEY / TELEGRAM_* / WATCH_LIST 를 그대로 씁니다.

# 기업 하나당 구글 뉴스에서 최근 몇 개까지 확인할지 (기본 5개)
# NEWS_PER_COMPANY=5

# 뉴스 "제목"에 아래 키워드 중 하나도 없으면 Claude 를 호출하지 않고 건너뜁니다 (비용 절약용 1차 필터).
# 빈 문자열("")로 두면 필터 없이 전부 Claude에게 보냅니다.
# NEWS_INCLUDE_KEYWORDS=실적,계약,수주,인수,합병,특허,소송,리콜,화재,파업,감사의견,상장폐지,매각,유상증자,무상증자,배당,자사주,대표이사,신용등급,목표가,투자,증설,파산,부도,횡령,적자,흑자,신제품,단독,특징주

# Claude에게 보낼 기사 본문 최대 글자 수 (기본 3000자)
# MAX_ARTICLE_CHARS=3000
